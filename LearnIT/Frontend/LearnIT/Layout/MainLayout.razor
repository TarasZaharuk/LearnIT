@inherits LayoutComponentBase
@inject UserAuthenticationStateProvider UserAuthenticationStateProvider

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider FullWidth="true"
                   MaxWidth="MaxWidth.Small"
                   CloseButton="true"
                   BackdropClick="false"
                   NoHeader="true"
                   Position="DialogPosition.Center"
                   CloseOnEscapeKey="true"/>
<MudSnackbarProvider />
<div class="page" style="padding:0; left:0;">
    <div class="sidebar" style="padding:0; left:0;">
        <h1 style="margin-left:10px">LearnIT</h1>
        @if (_isUserInTutorRole)
        {
            <TutorViewNavMenu />
        }
        else
        {
            <NavMenu />
        }
    </div>

    <main style="padding:4; margin:4; width:100%;">
        <article class="content" style="padding:0; margin:0; width:100%;">
            @Body
        </article>
    </main>
</div>

@code {
    bool _isUserInTutorRole;

    protected override async Task OnInitializedAsync()
    {
        _isUserInTutorRole = await UserAuthenticationStateProvider.IsUserInRole("Tutor");
    }
}
