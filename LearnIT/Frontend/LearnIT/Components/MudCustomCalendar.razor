    private async Task OnCellClick(DateTime selectedDay)
    {
        var selectedDate = selectedDay.Date.Date;
        var selectedEvents = _events.Where(e => e.Start.Date <= selectedDate && (e.End == null || e.End.Value.Date >= selectedDate)).ToList();
        await OnSelectedItemsChange.InvokeAsync(selectedEvents);
        SelectedDayEvents = selectedEvents;
        _isOpen = true;

    }

    private async Task OnItemChange(CalendarItem item)
    {
        _selectedCalendarItem = item;
        await InvokeAsync(StateHasChanged);
    }

    private Task HandleItemClick(CalendarItem item)
    {
        _selectedCalendarItem = item;
        return InvokeAsync(StateHasChanged);
    }
}