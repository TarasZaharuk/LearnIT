@inherits ComponentBase
@using System.Globalization;

<MudCalendar EnableResizeItems="true"  EnableDragItems="true" ItemChanged="OnItemChange" CellClicked="OnCellClick" Items="_events" MonthCellMinHeight="160">
    <CellTemplate Context="context">
            <div style="background-color: rgb(17, 196, 77);">
                <MudText Style="color: #ffffff;" Typo="Typo.body1" Align="Align.Center">
                    @(context.Start?.ToString("HH:mm") ?? "--:--")- @(context.End?.ToString("HH:mm") ?? "--:--")
                </MudText>
            </div>
            <div style="flex: 1; overflow-y: auto; padding: 8px;">
                <MudButton OnClick="@((e) => HandleItemClick(context))" Style="width: 100%; text-transform: none; justify-content: flex-start;">
                    <MudText Typo="Typo.body2">@context.Text</MudText>
                </MudButton>
            </div>
        </div>
    </CellTemplate>
</MudCalendar>
@code {
