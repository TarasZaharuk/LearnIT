@using LearnIT.DTOs
@using LearnIT.Components
@using MudBlazor
@using Shared
@inherits ComponentBase
<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6">New Consultation</MudText>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudTextField Label="Title" FullWidth="true" @bind-Value="Title"></MudTextField>
                <MudTextField T="int" Label="Attendee (UserId)" FullWidth="true" @bind-Value="Attendee"></MudTextField>
                <MudTextField Adornment=Adornment.End AdornmentIcon="@Icons.Material.Filled.CalendarToday" OnAdornmentClick="OpenDatePickerPopover" T="string" ReadOnly="true" Label="DateRange" FullWidth="true" Text="@($"{Start:ddd dd/MM/yyyy}, {Start:HH:mm} - {End:HH:mm}")"></MudTextField>
                <MudDivider />
                <MudCollapse Expanded="_expanded">
                    <div style="padding: 16px; min-width: 400px;">
                        <MudStack Row="true" Spacing="2">
                            <MudDatePicker Label="Date"  @bind-Date="_selectedDate"></MudDatePicker>
                            <MudTimePicker Label="Start Time"  @bind-Time="_startTime" Editable="true" ImmediateText="true" ></MudTimePicker>
                            <MudTimePicker Label="End Time" @bind-Time="_endTime" Editable="true" ImmediateText="true" ></MudTimePicker>
                        </MudStack>
                    </div>
                </MudCollapse>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField Label="Description" FullWidth="true" Lines="5" @bind-Value="Description"></MudTextField>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Create">Create</MudButton>
        <MudButton Color="Color.Default" Variant="Variant.Text" OnClick="CloseDialog">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    public string Title { get; set; } = string.Empty;

    public int Attendee { get; set; }

    public string Description { get; set; } = string.Empty;

    [Parameter]
    public DateTime Start { get; set; } = DateTime.Now;

    [Parameter]
    public DateTime End { get; set; } = DateTime.Now.AddHours(1);

    [Parameter]
    public int TutorId { get; set; }

    private DateTime? _selectedDate;
    private TimeSpan? _startTime;
    private TimeSpan? _endTime;

    [CascadingParameter]
    public MudDialogInstance MudDialog { get; set; } = null!;

    private bool _expanded = false;


    public void OpenDatePickerPopover()
    {
        _selectedDate = Start.Date;
        _startTime = Start.TimeOfDay;
        _endTime = End.TimeOfDay;
        _expanded = !_expanded;
    }

    public void CloseDialog()
    {
        MudDialog.Cancel();
    }

    private void Create()
    {
        ApplyDateTimeSelection();

        var consultation = new Consultation
        {
            Title = Title,
            Description = string.IsNullOrWhiteSpace(Description) ? null : Description,
            AttendeeId = Attendee,
            TutorId = TutorId,
            Start = Start,
            End = End,
        };

        MudDialog.Close(DialogResult.Ok(consultation));
    }

    private void ApplyDateTimeSelection()
    {
        if (_selectedDate.HasValue && _startTime.HasValue && _endTime.HasValue)
        {
            Start = _selectedDate.Value.Add(_startTime.Value);
            End = _selectedDate.Value.Add(_endTime.Value);
        }
    }
}
