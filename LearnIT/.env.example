# Copy to .env (local) / .env.prod (prod smoke test) and fill in. Never commit the real files.

# --- local SQL Server container (docker-compose.yml) ---
MSSQL_SA_PASSWORD=YourStrong!Pass123

# --- app ---
APP_PORT=5000
IMAGE_NAME=learnit
IMAGE_TAG=latest

# At least 32 characters - HS256 signing key for JWT.
JWT_KEY=change-me-to-a-32-plus-character-random-secret
JWT_ISSUER=LearnITServer
JWT_AUDIENCE=LearnITServer

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SENDER_EMAIL=

# --- only for docker-compose.prod.yml ---
ACR_LOGIN_SERVER=youracr.azurecr.io
PUBLIC_BASE_URL=http://learnit-app.westeurope.azurecontainer.io:8080
SQL_CONNECTION_STRING=Server=tcp:your-sql-server.database.windows.net,1433;Initial Catalog=LearnIT;User ID=learnit_app;Password=;Encrypt=True;TrustServerCertificate=False;MultipleActiveResultSets=True;Connection Timeout=60;
