# Copy to deploy/aca.env and fill in. deploy/aca.env is git-ignored - never commit it.
#
# This file is sourced by bash, so any value containing spaces or shell characters
# must be quoted. Use SINGLE quotes for secrets - double quotes would expand $ and `.

# "Azure subscription 1". Pinned so a deploy cannot land in the wrong subscription.
SUBSCRIPTION_ID=87f800b8-0c86-4693-9837-41192429a956

ACR_NAME=acrlearnit
# ACR_LOGIN_SERVER defaults to <ACR_NAME>.azurecr.io
IMAGE_NAME=learnit
IMAGE_TAG=latest

RESOURCE_GROUP=rg-learnit
LOCATION=westeurope
ACA_ENV=learnit-env
ACA_APP=learnit
CONTAINER_PORT=8080

# Valid consumption-profile pairs: 0.5/1.0Gi, 0.75/1.5Gi, 1.0/2.0Gi, ...
ACA_CPU=0.5
ACA_MEMORY=1.0Gi
# min=0 enables scale-to-zero (cheapest, but a cold start pays for EF migrations too).
ACA_MIN_REPLICAS=1
# Keep max at 1 unless you move EF migrations out of app startup - see DEPLOYMENT.md.
ACA_MAX_REPLICAS=1

# Set once you know the FQDN, or leave empty to let the script derive https://<fqdn>.
PUBLIC_BASE_URL=

# Azure SQL Database (Encrypt=True is required; SQL auth shown here).
# The quotes are mandatory - "Initial Catalog" and "Connection Timeout" contain spaces.
SQL_CONNECTION_STRING='Server=tcp:learnit-sql.database.windows.net,1433;Initial Catalog=LearnIT;User ID=learnitadmin;Password=REPLACE_ME;Encrypt=True;TrustServerCertificate=False;MultipleActiveResultSets=True;Connection Timeout=60;'

JWT_KEY='change-me-to-a-32-plus-character-random-secret'
JWT_ISSUER=LearnITServer
JWT_AUDIENCE=LearnITServer

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=''
SMTP_PASSWORD=''
SENDER_EMAIL=''
